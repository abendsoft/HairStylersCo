{{ 'curlear-collection-list.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curlear-collection-list.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign show_card_overlay = section.settings.show_card_overlay
  if show_card_overlay == nil
    assign show_card_overlay = true
  endif

  assign card_overlay_color = section.settings.card_overlay_color | default: '#000000'
  assign card_overlay_opacity = section.settings.card_overlay_opacity | default: 45 | times: 0.01
  assign card_overlay_mid_opacity = section.settings.card_overlay_opacity | default: 45 | times: 0.0044
  assign card_overlay_mid = card_overlay_color | color_modify: 'alpha', card_overlay_mid_opacity
  assign card_overlay_end = card_overlay_color | color_modify: 'alpha', card_overlay_opacity
-%}

{%- capture button_gradient_angle -%}
  {%- render 'curlear-button-gradient-angle',
    direction: section.settings.button_gradient_direction,
    angle: section.settings.button_gradient_angle
  -%}
{%- endcapture -%}

{% style %}
  #shopify-section-{{ section.id }} .curlear-collection-list__slider,
  #shopify-section-{{ section.id }} .curlear-collection-list__grid {
    --curlear-list-cols: {{ section.settings.columns_desktop }};
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .curlear-collection-list__slider,
    #shopify-section-{{ section.id }} .curlear-collection-list__grid {
      --curlear-list-cols: {{ section.settings.columns_mobile }};
    }
  }

  {% unless section.settings.show_arrow_mobile %}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .curlear-collection-list__arrow {
        display: none;
      }
    }
  {% endunless %}

  {% if show_card_overlay %}
    #shopify-section-{{ section.id }} .curlear-collection-list__footer::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        transparent 0%,
        {{ card_overlay_mid }} 55%,
        {{ card_overlay_end }} 100%
      );
      pointer-events: none;
      z-index: 0;
    }
  {% endif %}
{% endstyle %}

<section
  class="curlear-collection-list section-{{ section.id }}-padding"
  style="
    {% if section.settings.use_section_bg_gradient %}background: linear-gradient(180deg, {{ section.settings.section_bg_gradient_start }}, {{ section.settings.section_bg_gradient_end }});{% else %}background-color: {{ section.settings.section_bg_color }};{% endif %}
    --curlear-btn-gradient-start: {{ section.settings.button_gradient_start }};
    --curlear-btn-gradient-middle: {{ section.settings.button_gradient_middle }};
    --curlear-btn-gradient-end: {{ section.settings.button_gradient_end }};
    --curlear-btn-gradient-angle: {{ button_gradient_angle }};
    --curlear-btn-text-color: {{ section.settings.button_text_color }};
  "
>
  <div class="curlear-collection-list__top" style="background-color: {{ section.settings.section_bg_color }};">
    <div class="page-width curlear-collection-list__top-inner">
      <h2 class="curlear-collection-list__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.show_button and section.settings.button_label != blank and section.settings.button_link != blank %}
        <a
          class="curlear-collection-list__button{% if section.settings.use_gradient_button %} curlear-collection-list__button--gradient{% endif %}"
          href="{{ section.settings.button_link }}"
          style="--curlear-list-btn-bg: {{ section.settings.button_color }}; --curlear-list-btn-color: {{ section.settings.button_text_color }};"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    {% if section.settings.layout_mode == 'slider' %}
      <div
        class="curlear-collection-list__slider-wrap"
        data-curlear-collection-slider
        data-autoplay="{% if section.settings.auto_slide %}true{% else %}false{% endif %}"
        data-speed="{{ section.settings.auto_slide_speed | times: 1000 }}"
      >
        {% if section.settings.show_slider_nav and section.blocks.size > 1 %}
          <div class="page-width">
            <div class="curlear-collection-list__nav">
              <button
                type="button"
                class="curlear-collection-list__nav-btn"
                data-curlear-collection-slider-prev
                aria-label="Previous slide"
              >
                &#8249;
              </button>
              <button
                type="button"
                class="curlear-collection-list__nav-btn"
                data-curlear-collection-slider-next
                aria-label="Next slide"
              >
                &#8250;
              </button>
            </div>
          </div>
        {% endif %}
        <div
          class="curlear-collection-list__slider"
          data-curlear-collection-slider-track
        >
          {% for block in section.blocks %}
            <div class="curlear-collection-list__item" {{ block.shopify_attributes }}>
              {% render 'curlear-collection-list-card',
                block: block,
                cols_desktop: section.settings.columns_desktop,
                cols_mobile: section.settings.columns_mobile
              %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="curlear-collection-list__grid">
        {% for block in section.blocks %}
          <div class="curlear-collection-list__item" {{ block.shopify_attributes }}>
            {% render 'curlear-collection-list-card',
              block: block,
              cols_desktop: section.settings.columns_desktop,
              cols_mobile: section.settings.columns_mobile
            %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Curelear collection list",
  "tag": "section",
  "class": "section-curlear-collection-list",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#F3E3D9"
    },
    {
      "type": "checkbox",
      "id": "use_section_bg_gradient",
      "label": "Use section background gradient",
      "default": true
    },
    {
      "type": "color",
      "id": "section_bg_gradient_start",
      "label": "Section gradient start",
      "default": "#E8D6CC"
    },
    {
      "type": "color",
      "id": "section_bg_gradient_end",
      "label": "Section gradient end",
      "default": "#D9B8A9"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#E7BDA9"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "use_gradient_button",
      "label": "Use gradient for button",
      "default": true
    },
    {
      "type": "color",
      "id": "button_gradient_start",
      "label": "Button gradient start",
      "default": "#F2C6B4"
    },
    {
      "type": "color",
      "id": "button_gradient_middle",
      "label": "Button gradient middle",
      "default": "#ECB7A3"
    },
    {
      "type": "color",
      "id": "button_gradient_end",
      "label": "Button gradient end",
      "default": "#C27A63"
    },
    {
      "type": "select",
      "id": "button_gradient_direction",
      "label": "Button gradient direction",
      "default": "top_bottom",
      "options": [
        { "value": "top_bottom", "label": "Top to bottom" },
        { "value": "bottom_top", "label": "Bottom to top" },
        { "value": "left_right", "label": "Left to right" },
        { "value": "right_left", "label": "Right to left" },
        { "value": "custom", "label": "Custom angle" }
      ]
    },
    {
      "type": "range",
      "id": "button_gradient_angle",
      "min": 0,
      "max": 360,
      "step": 4,
      "unit": "deg",
      "label": "Button gradient angle",
      "default": 180,
      "info": "Rotate the gradient to any angle. Used when direction is set to Custom angle."
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "default": "grid",
      "options": [
        { "value": "slider", "label": "Slider" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Collections per row (desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Collections per row (mobile)",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_arrow_mobile",
      "label": "Show arrow on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Footer overlay"
    },
    {
      "type": "checkbox",
      "id": "show_card_overlay",
      "label": "Show footer overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "card_overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "card_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "auto_slide",
      "label": "Auto slide (slider mode)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_slider_nav",
      "label": "Show previous/next arrows (slider mode)",
      "default": false
    },
    {
      "type": "range",
      "id": "auto_slide_speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Auto slide speed",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_heading",
          "label": "Custom heading",
          "info": "If set, this will be shown instead of collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "Lifestyle/model photo for the card background. Falls back to collection image if empty."
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product image",
          "info": "Product cutout shown on the right (e.g. styler, dryer). Falls back to the first product image in the collection."
        },
        {
          "type": "image_picker",
          "id": "arrow_icon",
          "label": "Arrow icon",
          "info": "Optional custom arrow beside the collection name. Uses the default arrow when empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curelear collection list"
    }
  ]
}
{% endschema %}
