{{ 'curlear-collection-list.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curlear-collection-list.js' | asset_url }}" defer="defer"></script>

<section
  class="curlear-collection-list section-{{ section.id }}-padding"
  style="{% if section.settings.use_section_bg_gradient %}background: linear-gradient(180deg, {{ section.settings.section_bg_gradient_start }}, {{ section.settings.section_bg_gradient_end }});{% else %}background-color: {{ section.settings.section_bg_color }};{% endif %}"
>
  <div class="curlear-collection-list__top" style="background-color: {{ section.settings.section_bg_color }};">
    <div class="page-width curlear-collection-list__top-inner">
      <h2 class="curlear-collection-list__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.show_button and section.settings.button_label != blank and section.settings.button_link != blank %}
        <a
          class="curlear-collection-list__button{% if section.settings.use_gradient_button %} curlear-collection-list__button--gradient{% endif %}"
          href="{{ section.settings.button_link }}"
          style="--curlear-list-btn-bg: {{ section.settings.button_color }}; --curlear-list-btn-color: {{ section.settings.button_text_color }}; --curlear-list-btn-gradient-start: {{ section.settings.button_gradient_start }}; --curlear-list-btn-gradient-end: {{ section.settings.button_gradient_end }};"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
  <div class="page-width">

    {% if section.blocks.size > 0 %}
      {% if section.settings.layout_mode == 'slider' %}
        <div
          class="curlear-collection-list__slider-wrap"
          data-curlear-collection-slider
          data-autoplay="{{ section.settings.auto_slide }}"
          data-speed="{{ section.settings.auto_slide_speed | times: 1000 }}"
        >
          {% if section.settings.show_slider_nav and section.blocks.size > section.settings.columns_desktop %}
            <div class="curlear-collection-list__nav">
              <button
                type="button"
                class="curlear-collection-list__nav-btn"
                data-curlear-collection-slider-prev
                aria-label="Previous slide"
              >
                &#8249;
              </button>
              <button
                type="button"
                class="curlear-collection-list__nav-btn"
                data-curlear-collection-slider-next
                aria-label="Next slide"
              >
                &#8250;
              </button>
            </div>
          {% endif %}
          <div
            class="curlear-collection-list__slider"
            style="--curlear-list-cols-desktop: {{ section.settings.columns_desktop }}; --curlear-list-cols-mobile: {{ section.settings.columns_mobile }};"
            data-curlear-collection-slider-track
          >
            {% for block in section.blocks %}
              {% assign block_collection = collections[block.settings.collection] %}
              {% assign block_image = block.settings.image %}
              <div class="curlear-collection-list__item" {{ block.shopify_attributes }}>
                <a class="curlear-collection-list__card" href="{% if block_collection != blank %}{{ block_collection.url }}{% else %}#{% endif %}">
                  <div class="curlear-collection-list__image-wrap">
                    {% if block_image != blank %}
                      {{
                        block_image
                        | image_url: width: 1400
                        | image_tag:
                          class: 'curlear-collection-list__image',
                          loading: 'lazy',
                          widths: '550, 760, 990, 1200, 1400',
                          sizes: '(min-width: 990px) 30vw, 90vw',
                          alt: block.settings.custom_heading | default: block_collection.title
                      }}
                    {% elsif block_collection != blank and block_collection.featured_image != blank %}
                      {{
                        block_collection.featured_image
                        | image_url: width: 1400
                        | image_tag:
                          class: 'curlear-collection-list__image',
                          loading: 'lazy',
                          widths: '550, 760, 990, 1200, 1400',
                          sizes: '(min-width: 990px) 30vw, 90vw',
                          alt: block_collection.featured_image.alt
                      }}
                    {% elsif block_collection != blank and block_collection.products_count > 0 and block_collection.products.first.featured_image != blank %}
                      {{
                        block_collection.products.first.featured_image
                        | image_url: width: 1400
                        | image_tag:
                          class: 'curlear-collection-list__image',
                          loading: 'lazy',
                          widths: '550, 760, 990, 1200, 1400',
                          sizes: '(min-width: 990px) 30vw, 90vw',
                          alt: block_collection.title
                      }}
                    {% else %}
                      {{ 'collection-1' | placeholder_svg_tag: 'curlear-collection-list__image placeholder-svg' }}
                    {% endif %}
                  </div>
                  <div class="curlear-collection-list__meta">
                    <p class="curlear-collection-list__card-heading">
                      {{ block.settings.custom_heading | default: block_collection.title | default: 'Collection' | escape }}
                    </p>
                    <span class="curlear-collection-list__arrow{% unless section.settings.show_arrow_mobile %} curlear-collection-list__arrow--hide-mobile{% endunless %}">
                      &rarr;
                    </span>
                  </div>
                </a>
              </div>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <div
          class="curlear-collection-list__grid"
          style="--curlear-list-cols-desktop: {{ section.settings.columns_desktop }}; --curlear-list-cols-mobile: {{ section.settings.columns_mobile }};"
        >
          {% for block in section.blocks %}
            {% assign block_collection = collections[block.settings.collection] %}
            {% assign block_image = block.settings.image %}
            <div class="curlear-collection-list__item" {{ block.shopify_attributes }}>
              <a class="curlear-collection-list__card" href="{% if block_collection != blank %}{{ block_collection.url }}{% else %}#{% endif %}">
                <div class="curlear-collection-list__image-wrap">
                  {% if block_image != blank %}
                    {{
                      block_image
                      | image_url: width: 1400
                      | image_tag:
                        class: 'curlear-collection-list__image',
                        loading: 'lazy',
                        widths: '550, 760, 990, 1200, 1400',
                        sizes: '(min-width: 990px) 30vw, 90vw',
                        alt: block.settings.custom_heading | default: block_collection.title
                    }}
                  {% elsif block_collection != blank and block_collection.featured_image != blank %}
                    {{
                      block_collection.featured_image
                      | image_url: width: 1400
                      | image_tag:
                        class: 'curlear-collection-list__image',
                        loading: 'lazy',
                        widths: '550, 760, 990, 1200, 1400',
                        sizes: '(min-width: 990px) 30vw, 90vw',
                        alt: block_collection.featured_image.alt
                    }}
                  {% elsif block_collection != blank and block_collection.products_count > 0 and block_collection.products.first.featured_image != blank %}
                    {{
                      block_collection.products.first.featured_image
                      | image_url: width: 1400
                      | image_tag:
                        class: 'curlear-collection-list__image',
                        loading: 'lazy',
                        widths: '550, 760, 990, 1200, 1400',
                        sizes: '(min-width: 990px) 30vw, 90vw',
                        alt: block_collection.title
                    }}
                  {% else %}
                    {{ 'collection-1' | placeholder_svg_tag: 'curlear-collection-list__image placeholder-svg' }}
                  {% endif %}
                </div>
                <div class="curlear-collection-list__meta">
                  <p class="curlear-collection-list__card-heading">
                    {{ block.settings.custom_heading | default: block_collection.title | default: 'Collection' | escape }}
                  </p>
                  <span class="curlear-collection-list__arrow{% unless section.settings.show_arrow_mobile %} curlear-collection-list__arrow--hide-mobile{% endunless %}">
                    &rarr;
                  </span>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Curelear collection list",
  "tag": "section",
  "class": "section-curlear-collection-list",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#F3E3D9"
    },
    {
      "type": "checkbox",
      "id": "use_section_bg_gradient",
      "label": "Use section background gradient",
      "default": true
    },
    {
      "type": "color",
      "id": "section_bg_gradient_start",
      "label": "Section gradient start",
      "default": "#E8D6CC"
    },
    {
      "type": "color",
      "id": "section_bg_gradient_end",
      "label": "Section gradient end",
      "default": "#D9B8A9"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#E7BDA9"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "use_gradient_button",
      "label": "Use gradient for button",
      "default": false
    },
    {
      "type": "color",
      "id": "button_gradient_start",
      "label": "Button gradient start",
      "default": "#F8D0BD"
    },
    {
      "type": "color",
      "id": "button_gradient_end",
      "label": "Button gradient end",
      "default": "#D99077"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "default": "slider",
      "options": [
        { "value": "slider", "label": "Slider" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Collections per row (desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Collections per row (mobile)",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_arrow_mobile",
      "label": "Show arrow on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_slide",
      "label": "Auto slide (slider mode)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_slider_nav",
      "label": "Show previous/next arrows (slider mode)",
      "default": false
    },
    {
      "type": "range",
      "id": "auto_slide_speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Auto slide speed",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_heading",
          "label": "Custom heading",
          "info": "If set, this will be shown instead of collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curelear collection list"
    }
  ]
}
{% endschema %}
