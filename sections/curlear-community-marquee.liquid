{{ 'curlear-community-marquee.css' | asset_url | stylesheet_tag }}

{%- capture button_gradient_angle -%}
  {%- render 'curlear-button-gradient-angle',
    direction: section.settings.button_gradient_direction,
    angle: section.settings.button_gradient_angle
  -%}
{%- endcapture -%}

<section
  class="curlear-community-marquee section-{{ section.id }}-padding"
  style="
    --curlear-community-bg-color: {{ section.settings.background_color }};
    --curlear-community-visible-images: {{ section.settings.visible_images }};
    --curlear-community-marquee-duration: {{ section.settings.marquee_speed }}s;
    --curlear-community-button-gradient-start: {{ section.settings.button_gradient_start }};
    --curlear-community-button-gradient-middle: {{ section.settings.button_gradient_middle }};
    --curlear-community-button-gradient-end: {{ section.settings.button_gradient_end }};
    --curlear-community-button-gradient-angle: {{ button_gradient_angle }};
  "
>
  <div class="page-width">
    {% if section.settings.top_heading != blank %}
      <h2 class="curlear-community-marquee__top-heading">{{ section.settings.top_heading }}</h2>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="curlear-community-marquee__marquee" data-curlear-community-marquee>
      <button type="button" class="curlear-marquee-resume" data-curlear-marquee-resume aria-hidden="true">
        Tap to resume marquee
      </button>
      <div class="curlear-community-marquee__track">
        {% for i in (1..4) %}
          {% for block in section.blocks %}
            <div class="curlear-community-marquee__item" {{ block.shopify_attributes }}>
              {% if block.settings.image_link != blank %}
                <a href="{{ block.settings.image_link }}" class="curlear-community-marquee__image-link" aria-label="Community image">
              {% endif %}

              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    class: 'curlear-community-marquee__image',
                    loading: 'lazy',
                    widths: '160, 240, 320, 480, 600',
                    sizes: '(min-width: 990px) 10vw, 25vw',
                    alt: block.settings.image_alt
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'curlear-community-marquee__image placeholder-svg' }}
              {% endif %}

              {% if block.settings.image_link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="page-width">
    <div class="curlear-community-marquee__bottom">
      {% if section.settings.bottom_heading != blank %}
        <h3 class="curlear-community-marquee__bottom-heading">{{ section.settings.bottom_heading }}</h3>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a class="curlear-community-marquee__button" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const initMarquee = (wrap) => {
      const track = wrap.querySelector('.curlear-community-marquee__track');
      const resumeBtn = wrap.querySelector('[data-curlear-marquee-resume]');
      if (!track) return;

      let isTouchPaused = false;

      const setTouchPausedState = (paused) => {
        isTouchPaused = paused;
        wrap.classList.toggle('is-touch-paused', paused);
        if (resumeBtn) {
          resumeBtn.setAttribute('aria-hidden', paused ? 'false' : 'true');
        }
      };

      const pauseForTouch = () => {
        if (isTouchPaused) return;
        setTouchPausedState(true);
        track.style.animationPlayState = 'paused';
      };

      wrap.addEventListener('touchstart', pauseForTouch, { passive: true });
      if (resumeBtn) {
        resumeBtn.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          setTouchPausedState(false);
          track.style.animationPlayState = 'running';
        });
      }
    };

    document.querySelectorAll('[data-curlear-community-marquee]').forEach(initMarquee);
  })();
</script>

{% schema %}
{
  "name": "Curlear community",
  "tag": "section",
  "class": "section-curlear-community-marquee",
  "max_blocks": 15,
  "settings": [
    {
      "type": "text",
      "id": "top_heading",
      "label": "Top heading",
      "default": "Our Community"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#F7F6F4"
    },
    {
      "type": "range",
      "id": "visible_images",
      "min": 5,
      "max": 10,
      "step": 1,
      "label": "Images shown in marquee",
      "default": 9
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Marquee speed",
      "default": 24
    },
    {
      "type": "text",
      "id": "bottom_heading",
      "label": "Bottom heading",
      "default": "Done In One Pass"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_gradient_start",
      "label": "Button gradient start",
      "default": "#F2C6B4"
    },
    {
      "type": "color",
      "id": "button_gradient_middle",
      "label": "Button gradient middle",
      "default": "#ECB7A3"
    },
    {
      "type": "color",
      "id": "button_gradient_end",
      "label": "Button gradient end",
      "default": "#C27A63"
    },
    {
      "type": "select",
      "id": "button_gradient_direction",
      "label": "Button gradient direction",
      "default": "top_bottom",
      "options": [
        { "value": "top_bottom", "label": "Top to bottom" },
        { "value": "bottom_top", "label": "Bottom to top" },
        { "value": "left_right", "label": "Left to right" },
        { "value": "right_left", "label": "Right to left" },
        { "value": "custom", "label": "Custom angle" }
      ]
    },
    {
      "type": "range",
      "id": "button_gradient_angle",
      "min": 0,
      "max": 360,
      "step": 4,
      "unit": "deg",
      "label": "Button gradient angle",
      "default": 180,
      "info": "Used when direction is set to Custom angle."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Community image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Image link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curlear community",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
