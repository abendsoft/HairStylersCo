{{ 'curlear-feature-cards.css' | asset_url | stylesheet_tag }}
{%- if section.settings.mobile_layout == 'slider' -%}
  <script src="{{ 'curlear-feature-cards.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --cfc-card-bg: {{ section.settings.card_background_color }};
    --cfc-heading-color: {{ section.settings.heading_color }};
    --cfc-text-color: {{ section.settings.text_color }};
    --cfc-card-radius: {{ section.settings.card_border_radius }}px;
  }
{%- endstyle -%}

{%- liquid
  assign cfc_items = 0
  for block in section.blocks
    if block.settings.icon != blank or block.settings.heading != blank or block.settings.text != blank
      assign cfc_items = cfc_items | plus: 1
    endif
  endfor
-%}

{%- if cfc_items > 0 -%}
  <div
    class="curlear-feature-cards{% if section.settings.mobile_layout == 'slider' %} curlear-feature-cards--mobile-slider{% endif %}"
    {% if section.settings.mobile_layout == 'slider' %}
      data-curlear-feature-cards
      data-autoplay="{% if section.settings.mobile_auto_slide %}true{% else %}false{% endif %}"
      data-speed="{{ section.settings.mobile_slide_speed | times: 1000 }}"
    {% endif %}
  >
    <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
      <div class="curlear-feature-cards__list" role="list" data-curlear-feature-cards-track>
        {%- for block in section.blocks -%}
          {%- liquid
            unless block.settings.icon != blank or block.settings.heading != blank or block.settings.text != blank
              continue
            endunless
          -%}
          <article class="curlear-feature-cards__card" role="listitem" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="curlear-feature-cards__icon" aria-hidden="true">
                {{
                  block.settings.icon
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    widths: '40, 60, 80, 100, 120',
                    sizes: '48px',
                    alt: ''
                }}
              </div>
            {%- endif -%}
            <div class="curlear-feature-cards__content">
              {%- if block.settings.heading != blank -%}
                <p class="curlear-feature-cards__heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="curlear-feature-cards__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Curlear feature cards",
  "tag": "section",
  "class": "section-curlear-feature-cards",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1f4f4a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1f4f4a"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid (stacked)" },
        { "value": "slider", "label": "Slider" }
      ]
    },
    {
      "type": "checkbox",
      "id": "mobile_auto_slide",
      "label": "Auto slide on mobile (slider mode)",
      "default": false,
      "visible_if": "{{ section.settings.mobile_layout == 'slider' }}"
    },
    {
      "type": "range",
      "id": "mobile_slide_speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Auto slide speed",
      "default": 4,
      "visible_if": "{{ section.settings.mobile_layout == 'slider' }}"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Add supporting text for this feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curlear feature cards",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "Customer service",
            "text": "It's not actually free we just price it into the products."
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Fast Free Shipping",
            "text": "Get free shipping on all orders of more than £0"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Refer a friend",
            "text": "Refer a friend and get 15% off each other - email us"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Secure payment",
            "text": "Your payment information is secure, don't stress"
          }
        }
      ]
    }
  ]
}
{% endschema %}
