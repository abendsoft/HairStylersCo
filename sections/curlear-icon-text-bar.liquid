{{ 'curlear-icon-text-bar.css' | asset_url | stylesheet_tag }}
{%- if section.settings.mobile_use_slider and section.settings.mobile_use_marquee == false -%}
  <script src="{{ 'curlear-icon-text-bar.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --citb-mobile-cols: {{ section.settings.mobile_columns }};
    --citb-marquee-duration: {{ section.settings.mobile_marquee_speed | default: 40 }}s;
  }

  #shopify-section-{{ section.id }} .curlear-icon-text-bar__heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .curlear-icon-text-bar__item + .curlear-icon-text-bar__item::before {
    background: {{ section.settings.divider_color }};
  }

  {%- if section.settings.mobile_use_marquee -%}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        padding-top: 10px;
        padding-bottom: 10px;
      }

      #shopify-section-{{ section.id }} .curlear-icon-text-bar__marquee .curlear-icon-text-bar__heading {
        font-size: {{ section.settings.heading_size | minus: 2 }}px;
      }
    }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign citb_items = 0
  for block in section.blocks
    assign citb_block_svg = block.settings.icon_svg | strip
    if block.settings.icon != blank or citb_block_svg != blank or block.settings.heading != blank
      assign citb_items = citb_items | plus: 1
    endif
  endfor
-%}

{%- if citb_items > 0 -%}
  <div
    class="curlear-icon-text-bar{% if section.settings.full_width %} curlear-icon-text-bar--full-width{% endif %}{% if section.settings.mobile_use_slider and section.settings.mobile_use_marquee == false %} curlear-icon-text-bar--mobile-slider{% endif %}{% if section.settings.mobile_use_marquee %} curlear-icon-text-bar--mobile-marquee{% endif %}{% if section.settings.mobile_use_marquee and section.settings.mobile_marquee_hide_icons %} curlear-icon-text-bar--marquee-hide-icons{% endif %}"
    {% if section.settings.mobile_use_slider and section.settings.mobile_use_marquee == false %}
      data-curlear-icon-text-bar
      data-autoplay="{% if section.settings.mobile_auto_slide %}true{% else %}false{% endif %}"
      data-speed="{{ section.settings.mobile_auto_slide_speed | times: 1000 }}"
    {% endif %}
  >
    <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
      <div class="curlear-icon-text-bar__grid" role="list" data-curlear-icon-text-bar-track>
        {%- for block in section.blocks -%}
          {% render 'curlear-icon-text-bar-item', block: block, layout: 'stack' %}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.mobile_use_marquee -%}
      <div class="curlear-icon-text-bar__marquee" data-curlear-icon-text-bar-marquee>
        <div class="curlear-icon-text-bar__marquee-track">
          {%- for copy in (1..2) -%}
            {%- for block in section.blocks -%}
              {% render 'curlear-icon-text-bar-item', block: block, layout: 'row' %}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Icon text bar",
  "tag": "section",
  "class": "section-curlear-icon-text-bar",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f7f4f0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Heading font size",
      "default": 15
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "min": 0,
      "max": 12,
      "step": 1,
      "unit": "%",
      "label": "Heading letter spacing",
      "default": 6,
      "info": "Percentage of font size. 6% gives a refined, premium look."
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "default": "500",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" }
      ]
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "checkbox",
      "id": "mobile_use_marquee",
      "label": "Show as marquee on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_marquee_speed",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "s",
      "label": "Marquee speed",
      "default": 40,
      "info": "Higher values scroll more slowly. Used when marquee is enabled on mobile."
    },
    {
      "type": "checkbox",
      "id": "mobile_marquee_hide_icons",
      "label": "Hide icons in marquee",
      "default": false,
      "info": "On mobile marquee only. Shows headings without icons."
    },
    {
      "type": "checkbox",
      "id": "mobile_use_slider",
      "label": "Show as slider on mobile",
      "default": false,
      "info": "Ignored when marquee on mobile is enabled."
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Items per row on mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "checkbox",
      "id": "mobile_auto_slide",
      "label": "Auto slide on mobile (slider mode)",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_auto_slide_speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Auto slide speed",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Icon item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG",
          "info": "Paste inline SVG code (e.g. <svg>...</svg>). Used instead of the icon image when filled in."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon text bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "heading": "1000+ Customers"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Free Shipping"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "5 Star Rating"
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "Best Selling In UK"
          }
        }
      ]
    }
  ]
}
{% endschema %}
