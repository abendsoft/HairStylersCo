{{ 'curlear-image-accordion-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curlear-image-accordion-showcase.js' | asset_url }}" defer="defer"></script>

<section
  class="curlear-image-accordion-showcase section-{{ section.id }}-padding"
  style="
    --curlear-showcase-section-bg: {{ section.settings.section_bg_color }};
    --curlear-showcase-content-bg: {{ section.settings.content_bg_color }};
    --curlear-showcase-media-bg: {{ section.settings.media_bg_color }};
  "
>
  <div class="page-width">
    <div class="curlear-image-accordion-showcase__inner" data-curlear-accordion-showcase>
      <div class="curlear-image-accordion-showcase__media">
        {% assign image_blocks_count = 0 %}
        {% assign fallback_image = blank %}
        {% for block in section.blocks %}
          {% if block.settings.image != blank %}
            {% assign image_blocks_count = image_blocks_count | plus: 1 %}
            {% if fallback_image == blank %}
              {% assign fallback_image = block.settings.image %}
            {% endif %}
          {% endif %}
        {% endfor %}

        <div class="curlear-image-accordion-showcase__slider" data-curlear-showcase-track>
          {% for block in section.blocks %}
            <article
              class="curlear-image-accordion-showcase__slide{% if forloop.first %} is-active{% endif %}"
              data-curlear-showcase-slide
              data-index="{{ forloop.index0 }}"
              data-has-image="{% if block.settings.image != blank %}true{% else %}false{% endif %}"
              {% unless forloop.first %}hidden{% endunless %}
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'curlear-image-accordion-showcase__image',
                    loading: 'lazy',
                    widths: '550, 760, 990, 1200, 1500, 1800',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: block.settings.heading
                }}
              {% elsif fallback_image != blank %}
                {{
                  fallback_image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'curlear-image-accordion-showcase__image',
                    loading: 'lazy',
                    widths: '550, 760, 990, 1200, 1500, 1800',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: section.settings.heading
                }}
              {% endif %}
            </article>
          {% endfor %}
        </div>

        {% if image_blocks_count > 1 and section.settings.show_slider_buttons %}
          <div class="curlear-image-accordion-showcase__nav">
            <button type="button" class="curlear-image-accordion-showcase__nav-btn" data-curlear-showcase-prev aria-label="Previous image">
              &#8249;
            </button>
            <button type="button" class="curlear-image-accordion-showcase__nav-btn" data-curlear-showcase-next aria-label="Next image">
              &#8250;
            </button>
          </div>
        {% endif %}
      </div>

      <div class="curlear-image-accordion-showcase__content">
        {% if section.settings.caption != blank %}
          <p class="curlear-image-accordion-showcase__caption">{{ section.settings.caption }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="curlear-image-accordion-showcase__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        <div class="curlear-image-accordion-showcase__rows">
          {% for block in section.blocks %}
            <details class="curlear-image-accordion-showcase__row" data-curlear-showcase-row data-index="{{ forloop.index0 }}" {% if section.settings.open_first_row and forloop.first %}open{% endif %}>
              <summary class="curlear-image-accordion-showcase__summary">
                <span>{{ block.settings.heading | default: 'Feature' | escape }}</span>
                <span class="curlear-image-accordion-showcase__arrow"></span>
              </summary>
              <div class="curlear-image-accordion-showcase__content-wrap">
                <div class="curlear-image-accordion-showcase__row-content rte">{{ block.settings.content }}</div>
              </div>
            </details>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Curlear image accordion",
  "tag": "section",
  "class": "section-curlear-image-accordion-showcase",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "Caption text",
      "default": "MORE TO LOVE, WITH NEW IMPROVEMENTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OLD 10X STYLER VS. NEW 10X STYLER"
    },
    {
      "type": "checkbox",
      "id": "open_first_row",
      "label": "Initially open first row",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_slider_buttons",
      "label": "Show image slider buttons",
      "default": true
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "Content area background color",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Image area background color",
      "default": "#F2DED3"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Row heading",
          "default": "Sleeker, Modern Design"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Row content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Row image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curlear image accordion",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
