{{ 'curlear-image-accordion-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curlear-image-accordion-showcase.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign showcase_image = section.settings.image
  if showcase_image == blank
    for block in section.blocks
      if block.settings.image != blank
        assign showcase_image = block.settings.image
        break
      endif
    endfor
  endif

  assign use_custom_column_widths = section.settings.use_custom_column_widths
  assign content_column_width = section.settings.content_column_width | default: 50
  assign media_column_width = section.settings.media_column_width | default: 50
  assign column_width_total = content_column_width | plus: media_column_width
  if use_custom_column_widths and column_width_total > 0
    assign content_column_width = content_column_width | times: 100 | divided_by: column_width_total
    assign media_column_width = 100 | minus: content_column_width
  else
    assign content_column_width = 50
    assign media_column_width = 50
  endif

  if section.settings.reverse_columns_mobile
    assign grid_column_one_width = media_column_width
    assign grid_column_two_width = content_column_width
  else
    assign grid_column_one_width = content_column_width
    assign grid_column_two_width = media_column_width
  endif
-%}

{% style %}
  @media screen and (min-width: 990px) {
    {% if section.settings.use_custom_column_widths %}
      #shopify-section-{{ section.id }} .curlear-image-accordion-showcase__inner--custom-cols {
        grid-template-columns: minmax(0, {{ grid_column_one_width }}%) minmax(0, {{ grid_column_two_width }}%);
      }

      #shopify-section-{{ section.id }} .curlear-image-accordion-showcase__inner--custom-cols .curlear-image-accordion-showcase__content {
        grid-column: 1;
      }

      #shopify-section-{{ section.id }} .curlear-image-accordion-showcase__inner--custom-cols .curlear-image-accordion-showcase__media {
        grid-column: 2;
      }

      #shopify-section-{{ section.id }} .curlear-image-accordion-showcase__inner--custom-cols.curlear-image-accordion-showcase__inner--reversed .curlear-image-accordion-showcase__content {
        grid-column: 2;
      }

      #shopify-section-{{ section.id }} .curlear-image-accordion-showcase__inner--custom-cols.curlear-image-accordion-showcase__inner--reversed .curlear-image-accordion-showcase__media {
        grid-column: 1;
      }
    {% endif %}
  }
{% endstyle %}

<section
  class="curlear-image-accordion-showcase section-{{ section.id }}-padding"
  style="
    --curlear-showcase-section-bg: {{ section.settings.section_bg_color }};
    --curlear-showcase-content-bg: {{ section.settings.content_bg_color }};
    --curlear-showcase-media-bg: {{ section.settings.media_bg_color }};
    --curlear-accordion-content-padding-top: {{ section.settings.content_padding_top }}px;
    --curlear-accordion-content-padding-right: {{ section.settings.content_padding_right }}px;
    --curlear-accordion-content-padding-bottom: {{ section.settings.content_padding_bottom }}px;
    --curlear-accordion-content-padding-left: {{ section.settings.content_padding_left }}px;
  "
>
  <div class="page-width">
    <div
      class="curlear-image-accordion-showcase__inner{% if section.settings.reverse_columns_mobile %} curlear-image-accordion-showcase__inner--reversed{% endif %}{% if section.settings.use_custom_column_widths %} curlear-image-accordion-showcase__inner--custom-cols{% endif %} curlear-image-accordion-showcase__inner--align-{{ section.settings.content_alignment }}"
      data-curlear-accordion-showcase
    >
      <div class="curlear-image-accordion-showcase__media">
        {% if showcase_image != blank %}
          {{
            showcase_image
            | image_url: width: 1400
            | image_tag:
              class: 'curlear-image-accordion-showcase__image',
              loading: 'lazy',
              widths: '550, 760, 990, 1200, 1400',
              sizes: '(min-width: 990px) 48vw, 100vw',
              alt: section.settings.heading
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'curlear-image-accordion-showcase__image placeholder-svg' }}
        {% endif %}
      </div>

      <div class="curlear-image-accordion-showcase__content curlear-image-accordion-showcase__content--{{ section.settings.content_alignment }}{% unless section.settings.content_full_width %} curlear-image-accordion-showcase__content--narrow{% endunless %}">
        <div class="curlear-image-accordion-showcase__content-body">
        {% if section.settings.top_heading != blank %}
          <p class="curlear-image-accordion-showcase__top-heading">{{ section.settings.top_heading }}</p>
        {% endif %}
        {% if section.settings.caption != blank %}
          <p class="curlear-image-accordion-showcase__caption">{{ section.settings.caption }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="curlear-image-accordion-showcase__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        <div class="curlear-image-accordion-showcase__rows">
          {% for block in section.blocks %}
            <details class="curlear-image-accordion-showcase__row" data-curlear-showcase-row {{ block.shopify_attributes }} {% if section.settings.open_first_row and forloop.first %}open{% endif %}>
              <summary class="curlear-image-accordion-showcase__summary">
                <span>{{ block.settings.heading | default: 'Feature' | escape }}</span>
                <span class="curlear-image-accordion-showcase__arrow{% if section.settings.arrow_icon != blank %} has-custom-icon{% endif %}">
                  {% if section.settings.arrow_icon != blank %}
                    {{
                      section.settings.arrow_icon
                      | image_url: width: 48
                      | image_tag:
                        class: 'curlear-image-accordion-showcase__arrow-icon',
                        loading: 'lazy',
                        widths: '24, 36, 48',
                        sizes: '24px',
                        alt: 'Toggle row'
                    }}
                  {% endif %}
                </span>
              </summary>
              <div class="curlear-image-accordion-showcase__content-wrap">
                <div class="curlear-image-accordion-showcase__row-content rte">{{ block.settings.content }}</div>
              </div>
            </details>
          {% endfor %}
        </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Curlear image accordion",
  "tag": "section",
  "class": "section-curlear-image-accordion-showcase",
  "max_blocks": 8,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image",
      "info": "One image shown beside the accordion on all rows."
    },
    {
      "type": "text",
      "id": "top_heading",
      "label": "Top heading (above caption)",
      "default": "COMPARE FEATURES"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption text",
      "default": "MORE TO LOVE, WITH NEW IMPROVEMENTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OLD 10X STYLER VS. NEW 10X STYLER"
    },
    {
      "type": "checkbox",
      "id": "open_first_row",
      "label": "Initially open first row",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reverse_columns_mobile",
      "label": "Reverse columns (image first)",
      "default": false
    },
    {
      "type": "header",
      "content": "Column widths (desktop)"
    },
    {
      "type": "checkbox",
      "id": "use_custom_column_widths",
      "label": "Use custom column widths",
      "default": false,
      "info": "Adjust the content and image column split on desktop. Mobile always stacks to one column."
    },
    {
      "type": "range",
      "id": "content_column_width",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Content column width",
      "default": 50
    },
    {
      "type": "range",
      "id": "media_column_width",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Image column width",
      "default": 50,
      "info": "Widths are scaled proportionally to total 100%."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content vertical alignment",
      "default": "start",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "End" }
      ]
    },
    {
      "type": "checkbox",
      "id": "content_full_width",
      "label": "Full content width on desktop",
      "default": false,
      "info": "When enabled, content spans the full column width. When disabled, content uses a narrower width (recommended for start alignment)."
    },
    {
      "type": "header",
      "content": "Content area padding"
    },
    {
      "type": "range",
      "id": "content_padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_padding_right",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding right",
      "default": 24
    },
    {
      "type": "range",
      "id": "content_padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_padding_left",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Padding left",
      "default": 24
    },
    {
      "type": "image_picker",
      "id": "arrow_icon",
      "label": "Accordion arrow icon"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background color",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "Content area background color",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Image area background color",
      "default": "#F2DED3"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Row heading",
          "default": "Sleeker, Modern Design"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Row content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curlear image accordion",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
