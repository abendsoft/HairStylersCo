{{ 'curlear-image-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curlear-image-showcase.js' | asset_url }}" defer="defer"></script>

{% style %}
  #shopify-section-{{ section.id }} .curlear-image-showcase__slider,
  #shopify-section-{{ section.id }} .curlear-image-showcase__grid {
    --curlear-image-cols: {{ section.settings.columns_desktop }};
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .curlear-image-showcase__slider,
    #shopify-section-{{ section.id }} .curlear-image-showcase__grid {
      --curlear-image-cols: {{ section.settings.columns_mobile }};
    }
  }
{% endstyle %}

{%- liquid
  assign desktop_vw = 100 | divided_by: section.settings.columns_desktop
  assign mobile_vw = 100 | divided_by: section.settings.columns_mobile
  assign image_sizes = '(min-width: 750px) ' | append: desktop_vw | append: 'vw, ' | append: mobile_vw | append: 'vw'
-%}

<section
  class="curlear-image-showcase section-{{ section.id }}-padding{% unless section.settings.full_width %} curlear-image-showcase--contained{% endunless %}"
  style="background-color: {{ section.settings.background_color }};"
>
  {% if section.settings.heading != blank %}
    <div class="page-width">
      <h2 class="curlear-image-showcase__heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    {% if section.settings.layout_mode == 'slider' %}
      <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
        <div
          class="curlear-image-showcase__slider-wrap"
          data-curlear-image-slider
          data-autoplay="{% if section.settings.auto_slide %}true{% else %}false{% endif %}"
          data-speed="{{ section.settings.auto_slide_speed | times: 1000 }}"
        >
          {% if section.settings.show_slider_nav and section.blocks.size > 1 %}
            <div class="curlear-image-showcase__nav">
              <button
                type="button"
                class="curlear-image-showcase__nav-btn"
                data-curlear-image-slider-prev
                aria-label="Previous slide"
              >
                &#8249;
              </button>
              <button
                type="button"
                class="curlear-image-showcase__nav-btn"
                data-curlear-image-slider-next
                aria-label="Next slide"
              >
                &#8250;
              </button>
            </div>
          {% endif %}
          <div class="curlear-image-showcase__slider" data-curlear-image-slider-track>
            {% for block in section.blocks %}
              {% render 'curlear-image-showcase-card', block: block, image_sizes: image_sizes %}
            {% endfor %}
          </div>
        </div>
      </div>
    {% else %}
      <div class="{% unless section.settings.full_width %}page-width{% endunless %}">
        <div class="curlear-image-showcase__grid">
          {% for block in section.blocks %}
            {% render 'curlear-image-showcase-card', block: block, image_sizes: image_sizes %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Curelear image show",
  "tag": "section",
  "class": "section-curlear-image-showcase",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Everything You Need For Prettier Hair"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width section",
      "default": true
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "default": "slider",
      "options": [
        { "value": "slider", "label": "Slider" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Images per row (desktop)",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Images per row (mobile)",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "checkbox",
      "id": "auto_slide",
      "label": "Auto slide (slider mode)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_slider_nav",
      "label": "Show previous/next arrows (slider mode)",
      "default": false
    },
    {
      "type": "range",
      "id": "auto_slide_speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "unit": "s",
      "label": "Auto slide speed",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Image block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "overlay_heading",
          "label": "Heading",
          "default": "STRAIGHT"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "Text line",
          "default": "One pass. Smooth."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curelear image show"
    }
  ]
}
{% endschema %}
