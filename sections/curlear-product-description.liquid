{{ 'curlear-product-description.css' | asset_url | stylesheet_tag }}
<script src="{{ 'curlear-product-description.js' | asset_url }}" defer="defer"></script>

{%- if section.blocks.size > 0 -%}
  <section
    class="curlear-product-description section-{{ section.id }}-padding"
    style="
      --cpd-bg: {{ section.settings.background_color }};
      --cpd-surface: {{ section.settings.surface_color }};
      --cpd-card-bg: {{ section.settings.card_background_color }};
      --cpd-heading: {{ section.settings.heading_color }};
      --cpd-text: {{ section.settings.text_color }};
      --cpd-muted: {{ section.settings.muted_text_color }};
      --cpd-accent: {{ section.settings.accent_color }};
      --cpd-highlight-heading: {{ section.settings.highlight_heading_color }};
      --cpd-warning-bg: {{ section.settings.warning_background_color }};
      --cpd-warning-text: {{ section.settings.warning_text_color }};
      --cpd-border: {{ section.settings.border_color }};
      --cpd-max-width: {{ section.settings.max_width }}px;
      --cpd-pad-top: {{ section.settings.padding_top }}px;
      --cpd-pad-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="curlear-product-description__inner">
      <div class="cpd-tabs{% unless section.settings.desktop_use_tabs %} cpd-tabs--stacked{% endunless %}" data-cpd-tabs>
        <div class="cpd-tabs__nav" role="tablist">
          {%- for block in section.blocks -%}
            {%- assign cpd_tab_label = '' -%}

            {%- case block.type -%}
              {%- when 'overview' -%}
                {%- assign cpd_tab_label = section.settings.tab_overview_label | default: 'Overview' -%}
              {%- when 'specifications' -%}
                {%- assign cpd_tab_label = section.settings.tab_specs_label | default: 'Specs' -%}
              {%- when 'features' -%}
                {%- assign cpd_tab_label = section.settings.tab_features_label | default: 'Features' -%}
              {%- when 'flavours' -%}
                {%- assign cpd_tab_label = section.settings.tab_flavours_label | default: 'Flavours' -%}
              {%- when 'whats_in_box' -%}
                {%- assign cpd_tab_label = section.settings.tab_whats_in_box_label | default: "What's in the box" -%}
              {%- when 'affordable_pricing' -%}
                {%- assign cpd_tab_label = section.settings.tab_affordable_pricing_label | default: 'Affordable pricing' -%}
              {%- when 'how_to_use' -%}
                {%- assign cpd_tab_label = section.settings.tab_how_to_use_label | default: 'How To Use' -%}
              {%- when 'when_to_replace' -%}
                {%- assign cpd_tab_label = section.settings.tab_when_to_replace_label | default: 'When to replace' -%}
              {%- when 'faq' -%}
                {%- assign cpd_tab_label = section.settings.tab_faq_label | default: 'FAQ' -%}
            {%- endcase -%}

            <button
              type="button"
              class="cpd-tabs__trigger{% if forloop.first %} is-active{% endif %}"
              data-cpd-tab-trigger
              data-cpd-tab="{{ block.id }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="cpd-panel-{{ block.id }}-{{ section.id }}"
              id="cpd-tab-{{ block.id }}-{{ section.id }}"
            >
              {{ cpd_tab_label | escape }}
            </button>
          {%- endfor -%}
        </div>

        <div class="cpd-tabs__panels">
          {%- for block in section.blocks -%}
            <div
              class="cpd-tabs__panel{% if forloop.first %} is-active{% endif %}"
              id="cpd-panel-{{ block.id }}-{{ section.id }}"
              role="tabpanel"
              aria-labelledby="cpd-tab-{{ block.id }}-{{ section.id }}"
              data-cpd-panel="{{ block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
            >
              {% render 'curlear-product-description-block', block: block %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

