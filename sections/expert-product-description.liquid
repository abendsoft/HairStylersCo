<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ sid }}');
    if (!root) return;

    var showTab2 = {{ show_tab2 | json }};
    var mq = window.matchMedia('(min-width: 750px)');

    function setTab(index) {
      var triggers = root.querySelectorAll('[data-epd-tab-trigger]');
      var panels = root.querySelectorAll('[data-epd-panel]');
      triggers.forEach(function (btn) {
        var on = btn.getAttribute('data-epd-tab') === String(index);
        btn.classList.toggle('epd-tabs__trigger--active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach(function (panel) {
        var on = panel.getAttribute('data-epd-panel') === String(index);
        panel.classList.toggle('epd-tabs__panel--active', on);
        if (on) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', 'hidden');
        }
      });
      if (showTab2) {
        var mobileHeads = root.querySelectorAll('[data-epd-mobile-toggle]');
        mobileHeads.forEach(function (head) {
          var on = head.getAttribute('data-epd-tab') === String(index);
          head.classList.toggle('epd-tabs__mobile-head--active', on);
          head.setAttribute('aria-expanded', on ? 'true' : 'false');
        });
      }
    }

    root.querySelectorAll('[data-epd-tab-trigger]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        setTab(btn.getAttribute('data-epd-tab'));
      });
    });

    function mobileToggle(head) {
      var tab = head.getAttribute('data-epd-tab');
      var expanded = head.getAttribute('aria-expanded') === 'true';
      if (mq.matches) return;
      if (expanded) return;
      setTab(tab);
    }

    root.querySelectorAll('[data-epd-mobile-toggle]').forEach(function (head) {
      head.addEventListener('click', function () {
        mobileToggle(head);
      });
    });

    mq.addEventListener('change', function () {
      if (mq.matches) {
        var active = root.querySelector('.epd-tabs__trigger--active');
        if (active) setTab(active.getAttribute('data-epd-tab'));
        else setTab('1');
      }
    });

    root.querySelectorAll('[data-epd-faq-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.epd-faq-item');
        if (!item) return;
        var list = item.closest('.epd-faq-list');
        var wasOpen = item.classList.contains('is-open');
        if (list) {
          list.querySelectorAll('.epd-faq-item').forEach(function (other) {
            if (other !== item) {
              other.classList.remove('is-open');
              var ob = other.querySelector('[data-epd-faq-toggle]');
              if (ob) ob.setAttribute('aria-expanded', 'false');
            }
          });
        }
        if (wasOpen) {
          item.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    root.querySelectorAll('[data-epd-policy-acc-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.epd-policy-acc-item');
        if (!item) return;
        var grid = item.closest('.epd-policy-acc-grid');
        var wasOpen = item.classList.contains('is-open');
        if (grid) {
          grid.querySelectorAll('.epd-policy-acc-item').forEach(function (other) {
            if (other !== item) {
              other.classList.remove('is-open');
              var ob = other.querySelector('[data-epd-policy-acc-toggle]');
              if (ob) ob.setAttribute('aria-expanded', 'false');
            }
          });
        }
        if (wasOpen) {
          item.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

