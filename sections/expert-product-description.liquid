{% comment %}
  Expert Product Description — section + `snippets/expert-product-description-stack.liquid` (block markup).
  Portable across themes; scoped with .epd and section.id.
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign show_tab2 = section.settings.show_second_tab
  assign tab1_label = section.settings.tab_primary_label | default: 'Description'
  assign tab2_label = section.settings.tab_secondary_label | default: 'Shipping & Returns Policy'
-%}

<section
  id="shopify-section-{{ sid }}"
  class="epd expert-product-description"
  style="
    --epd-max-width: {{ section.settings.max_width }}px;
    --epd-pad-top: {{ section.settings.padding_top }}px;
    --epd-pad-bottom: {{ section.settings.padding_bottom }}px;
    --epd-radius: {{ section.settings.card_radius }}px;
    --epd-gap: {{ section.settings.block_gap }}px;
    --epd-bg: {{ section.settings.color_background }};
    --epd-surface: {{ section.settings.color_surface }};
    --epd-heading: {{ section.settings.color_heading }};
    --epd-text: {{ section.settings.color_text }};
    --epd-muted: {{ section.settings.color_muted }};
    --epd-accent: {{ section.settings.color_accent }};
    --epd-border: {{ section.settings.color_border }};
    --epd-tab-active-bg: {{ section.settings.tab_active_bg }};
    --epd-tab-active-text: {{ section.settings.tab_active_text }};
    --epd-tab-inactive-bg: {{ section.settings.tab_inactive_bg }};
    --epd-tab-inactive-text: {{ section.settings.tab_inactive_text }};
    --epd-badge-text: {{ section.settings.color_badge_text }};
    --epd-heading-size: {{ section.settings.heading_size | plus: 4 }}px;
    --epd-subheading-size: {{ section.settings.subheading_size | plus: 4 }}px;
    --epd-body-size: {{ section.settings.body_size | plus: 2 }}px;
    --epd-table-thead-bg: {{ section.settings.table_header_bg }};
    --epd-table-thead-text: {{ section.settings.table_header_text }};
    --epd-table-tbody-bg: {{ section.settings.table_body_bg }};
    --epd-table-row-text: {{ section.settings.table_row_text }};
    --epd-table-row-hover: {{ section.settings.table_row_hover_bg }};
    --epd-flavour-card-bg: {{ section.settings.flavour_card_bg }};
    --epd-flavour-card-top: {{ section.settings.flavour_card_top_border }};
    --epd-flavour-card-heading: {{ section.settings.flavour_card_heading }};
    --epd-flavour-card-text: {{ section.settings.flavour_card_text }};
  "
>
  <div class="epd__inner">
    <div class="epd-tabs" data-epd-tabs>
      {% if show_tab2 %}
        <ul class="epd-tabs__list epd-tabs__list--desktop" role="tablist">
          <li class="epd-tabs__tab" role="presentation">
            <button
              type="button"
              class="epd-tabs__trigger epd-tabs__trigger--active"
              role="tab"
              aria-selected="true"
              aria-controls="epd-panel-1-{{ sid }}"
              id="epd-tab-1-{{ sid }}"
              data-epd-tab-trigger
              data-epd-tab="1"
            >
              {{ tab1_label | escape }}
            </button>
          </li>
          <li class="epd-tabs__tab" role="presentation">
            <button
              type="button"
              class="epd-tabs__trigger"
              role="tab"
              aria-selected="false"
              aria-controls="epd-panel-2-{{ sid }}"
              id="epd-tab-2-{{ sid }}"
              data-epd-tab-trigger
              data-epd-tab="2"
            >
              {{ tab2_label | escape }}
            </button>
          </li>
        </ul>
      {% endif %}

      <div class="epd-tabs__panels">
        {% if show_tab2 %}
          <div
            class="epd-tabs__mobile-acc epd-tabs__mobile-acc--primary"
            data-epd-mobile-tab="1"
          >
            <button
              type="button"
              class="epd-tabs__mobile-head epd-tabs__mobile-head--active"
              data-epd-mobile-toggle
              data-epd-tab="1"
              aria-expanded="true"
              aria-controls="epd-panel-1-{{ sid }}"
            >
              <span>{{ tab1_label | escape }}</span>
              <span class="epd-tabs__chev" aria-hidden="true">
                <svg class="epd-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.5 5.25 7 8.75l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>
          </div>
        {% endif %}

        <div
          class="epd-tabs__panel epd-tabs__panel--active"
          role="tabpanel"
          id="epd-panel-1-{{ sid }}"
          {% if show_tab2 %}
            aria-labelledby="epd-tab-1-{{ sid }}"
          {% else %}
            aria-label="{{ tab1_label | escape }}"
          {% endif %}
          data-epd-panel="1"
          {% unless show_tab2 %}data-epd-single-tab{% endunless %}
        >
          <div class="epd-stack">
            {% render 'expert-product-description-stack', section: section, epd_tab_target: 'primary' %}
          </div>
        </div>

        {% if show_tab2 %}
          <div class="epd-tabs__mobile-acc" data-epd-mobile-tab="2">
            <button
              type="button"
              class="epd-tabs__mobile-head"
              data-epd-mobile-toggle
              data-epd-tab="2"
              aria-expanded="false"
              aria-controls="epd-panel-2-{{ sid }}"
            >
              <span>{{ tab2_label | escape }}</span>
              <span class="epd-tabs__chev" aria-hidden="true">
                <svg class="epd-chevron" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.5 5.25 7 8.75l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </button>
          </div>

          <div
            class="epd-tabs__panel"
            role="tabpanel"
            id="epd-panel-2-{{ sid }}"
            aria-labelledby="epd-tab-2-{{ sid }}"
            data-epd-panel="2"
            hidden
          >
            <div class="epd-stack">
              {% render 'expert-product-description-stack', section: section, epd_tab_target: 'secondary' %}
            </div>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ sid }}.epd {
    background: var(--epd-bg);
    padding-top: var(--epd-pad-top);
    padding-bottom: var(--epd-pad-bottom);
    color: var(--epd-text);
    font-size: var(--epd-body-size);
  }

  #shopify-section-{{ sid }} .epd__inner {
    max-width: var(--epd-max-width);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  #shopify-section-{{ sid }} .epd-tabs__list {
    display: none;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    gap: 0.5rem;
    border-bottom: 1px solid var(--epd-border);
  }

  @media (min-width: 750px) {
    #shopify-section-{{ sid }} .epd-tabs__list--desktop {
      display: flex;
    }
    #shopify-section-{{ sid }} .epd-tabs__mobile-acc {
      display: none;
    }
  }

  #shopify-section-{{ sid }} .epd-tabs__trigger {
    appearance: none;
    border: none;
    background: var(--epd-tab-inactive-bg);
    cursor: pointer;
    font: inherit;
    color: var(--epd-tab-inactive-text);
    padding: 0.85rem 1.1rem;
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    border-radius: var(--epd-radius) var(--epd-radius) 0 0;
  }

  #shopify-section-{{ sid }} .epd-tabs__trigger--active {
    color: var(--epd-tab-active-text);
    background: var(--epd-tab-active-bg);
    border-bottom-color: var(--epd-accent);
    font-weight: 600;
  }

  #shopify-section-{{ sid }} .epd-tabs__panel {
    padding-top: 0.25rem;
  }

  #shopify-section-{{ sid }} .epd-tabs__panel[hidden] {
    display: none !important;
  }

  #shopify-section-{{ sid }} .epd-tabs__mobile-head {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1rem;
    margin: 0;
    border: 1px solid var(--epd-border);
    border-radius: var(--epd-radius);
    background: var(--epd-surface);
    font: inherit;
    font-weight: 600;
    color: var(--epd-text);
    cursor: pointer;
    text-align: left;
  }

  #shopify-section-{{ sid }} .epd-tabs__mobile-head--active {
    border-color: var(--epd-accent);
  }

  #shopify-section-{{ sid }} .epd-tabs__chev {
    display: inline-flex;
    transition: transform 0.2s ease;
    opacity: 0.7;
  }

  #shopify-section-{{ sid }} .epd-stack {
    display: flex;
    flex-direction: column;
    gap: var(--epd-gap);
  }

  #shopify-section-{{ sid }} .epd-block--center {
    text-align: center;
  }

  #shopify-section-{{ sid }} .epd-block--center .rte ul,
  #shopify-section-{{ sid }} .epd-block--center .rte ol {
    display: inline-block;
    text-align: left;
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-feature {
    justify-items: center;
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-feature__text {
    text-align: center;
  }

  #shopify-section-{{ sid }} .epd-block--center table.epd-table th,
  #shopify-section-{{ sid }} .epd-block--center table.epd-table td {
    text-align: center;
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-faq-head {
    justify-content: center;
    padding-inline: 2.5rem;
    position: relative;
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-faq-head .epd-tabs__chev {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-faq-item.is-open .epd-faq-head .epd-tabs__chev {
    transform: translateY(-50%) rotate(180deg);
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-policy-acc-head {
    justify-content: center;
    padding-inline: 2.5rem;
    position: relative;
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-policy-acc-head .epd-tabs__chev {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-policy-acc-item.is-open .epd-policy-acc-head .epd-tabs__chev {
    transform: translateY(-50%) rotate(180deg);
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-usage-steps {
    align-items: center;
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-usage-step {
    max-width: 40rem;
    margin-inline: auto;
  }

  #shopify-section-{{ sid }} .epd-block--center .epd-usage-step-text {
    text-align: center;
  }

  /* Flavours block: center only heading, intro & hero — keep flavour grid cards left-aligned */
  #shopify-section-{{ sid }} .epd-flavours.epd-block--center {
    text-align: left;
  }

  #shopify-section-{{ sid }} .epd-flavours.epd-block--center > h2,
  #shopify-section-{{ sid }} .epd-flavours.epd-block--center > .epd-flavours-intro,
  #shopify-section-{{ sid }} .epd-flavours.epd-block--center > .epd-flavours-hero {
    text-align: center;
  }

  #shopify-section-{{ sid }} .epd-flavours.epd-block--center > .epd-flavours-hero {
    margin-left: auto;
    margin-right: auto;
  }

  #shopify-section-{{ sid }} .epd-flavours.epd-block--center > .epd-flavours-subtitle,
  #shopify-section-{{ sid }} .epd-flavours.epd-block--center > .epd-flavours-intro--2,
  #shopify-section-{{ sid }} .epd-flavours.epd-block--center > .epd-flavours-intro--3 {
    text-align: center;
  }

  #shopify-section-{{ sid }} .epd-flavours-subtitle {
    font-size: calc(var(--epd-subheading-size) * 1.02);
    margin: 5rem;
    line-height: 1.25;
    font-weight: 700;
    color: var(--epd-heading);
  }

  #shopify-section-{{ sid }} .epd-flavours-intro--2,
  #shopify-section-{{ sid }} .epd-flavours-intro--3 {
    margin-bottom: 0.65rem;
  }

  #shopify-section-{{ sid }} .epd-about,
  #shopify-section-{{ sid }} .epd-specs,
  #shopify-section-{{ sid }} .epd-flavours,
  #shopify-section-{{ sid }} .epd-box,
  #shopify-section-{{ sid }} .epd-pricing,
  #shopify-section-{{ sid }} .epd-usage,
  #shopify-section-{{ sid }} .epd-faq-wrap,
  #shopify-section-{{ sid }} .epd-policy-multi,
  #shopify-section-{{ sid }} .epd-rich {
    background: var(--epd-surface);
    border: 1px solid var(--epd-border);
    border-radius: var(--epd-radius);
    padding: clamp(1.2rem, 3.5vw, 4rem);
  }

  /* After base padding above: desktop extra padding (--epd-desk-pad on .epd-block-root from block settings) */
  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .epd-about.epd-block-root,
    #shopify-section-{{ sid }} .epd-specs.epd-block-root,
    #shopify-section-{{ sid }} .epd-flavours.epd-block-root,
    #shopify-section-{{ sid }} .epd-box.epd-block-root,
    #shopify-section-{{ sid }} .epd-pricing.epd-block-root,
    #shopify-section-{{ sid }} .epd-usage.epd-block-root,
    #shopify-section-{{ sid }} .epd-faq-wrap.epd-block-root,
    #shopify-section-{{ sid }} .epd-policy-multi.epd-block-root,
    #shopify-section-{{ sid }} .epd-rich.epd-block-root {
      padding: calc(clamp(1.2rem, 3.5vw, 4rem) + var(--epd-desk-pad, 0px));
    }

    #shopify-section-{{ sid }} .epd-feature-stack.epd-block-root {
      padding: var(--epd-desk-pad, 0px);
    }

    #shopify-section-{{ sid }} .epd-flavour-card.epd-block-root {
      padding: calc(1.35rem + var(--epd-desk-pad, 0px)) calc(1.5rem + var(--epd-desk-pad, 0px))
        calc(1.55rem + var(--epd-desk-pad, 0px));
    }

    #shopify-section-{{ sid }} .epd-custom.epd-block-root {
      padding: calc(clamp(1.2rem, 3.5vw, 4rem) + var(--epd-desk-pad, 0px));
      background: var(--epd-surface);
      border: 1px solid var(--epd-border);
      border-radius: var(--epd-radius);
    }
  }

  #shopify-section-{{ sid }} .epd h2,
  #shopify-section-{{ sid }} .epd h3 {
    color: var(--epd-heading);
  }

  #shopify-section-{{ sid }} .epd-about h2,
  #shopify-section-{{ sid }} .epd-specs h2,
  #shopify-section-{{ sid }} .epd-flavours h2,
  #shopify-section-{{ sid }} .epd-box h2,
  #shopify-section-{{ sid }} .epd-pricing h2,
  #shopify-section-{{ sid }} .epd-usage h2,
  #shopify-section-{{ sid }} .epd-faq-wrap > h2,
  #shopify-section-{{ sid }} .epd-rich h2 {
    font-size: var(--epd-heading-size);
    margin: 0 0 2rem;
    line-height: 1.2;
  }

  #shopify-section-{{ sid }} .epd-feature__text h3,
  #shopify-section-{{ sid }} .epd-usage-step h3,
  #shopify-section-{{ sid }} .epd-faq-item h3 {
    font-size: var(--epd-subheading-size);
    margin: 0 0 2rem;
    line-height: 1.25;
  }

  #shopify-section-{{ sid }} .epd-about .rte,
  #shopify-section-{{ sid }} .epd-flavours-intro,
  #shopify-section-{{ sid }} .epd-pricing .rte,
  #shopify-section-{{ sid }} .epd-usage-intro,
  #shopify-section-{{ sid }} .epd-rich .rte {
    color: var(--epd-text);
  }

  #shopify-section-{{ sid }} .epd-about .rte p:last-child,
  #shopify-section-{{ sid }} .epd-pricing .rte p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ sid }} .epd-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: 0.5rem;
  }

  #shopify-section-{{ sid }} table.epd-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 280px;
  }

  #shopify-section-{{ sid }} table.epd-table th,
  #shopify-section-{{ sid }} table.epd-table td {
    border: 1px solid var(--epd-border);
    padding: 0.65rem 0.85rem;
    text-align: left;
    vertical-align: top;
  }

  #shopify-section-{{ sid }} table.epd-table thead th {
    background: var(--epd-table-thead-bg);
    color: var(--epd-table-thead-text);
    font-weight: 600;
  }

  #shopify-section-{{ sid }} table.epd-table tbody td {
    background: var(--epd-table-tbody-bg);
    color: var(--epd-table-row-text);
  }

  #shopify-section-{{ sid }} table.epd-table tbody tr {
    transition: background-color 0.2s ease;
  }

  #shopify-section-{{ sid }} table.epd-table tbody tr:hover td {
    background: var(--epd-table-row-hover);
  }

  #shopify-section-{{ sid }} .epd-feature-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--epd-border);
    border-radius: var(--epd-radius);
    overflow: hidden;
    background: var(--epd-surface);
  }

  #shopify-section-{{ sid }} .epd-feature-stack .epd-feature--stacked {
    display: grid;
    gap: 1.35rem;
    align-items: center;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: clamp(1.35rem, 3vw, 2rem) clamp(1rem, 3vw, 1.5rem);
    margin: 0;
  }

  #shopify-section-{{ sid }} .epd-feature-stack .epd-feature--stacked + .epd-feature--stacked {
    padding-top: clamp(1.65rem, 3.5vw, 2.35rem);
    border-top: none;
  }

  #shopify-section-{{ sid }} .epd-feature:not(.epd-feature--stacked) {
    display: grid;
    gap: 1.35rem;
    align-items: center;
    background: var(--epd-surface);
    border: 1px solid var(--epd-border);
    border-radius: var(--epd-radius);
    padding: clamp(1.15rem, 3.5vw, 2rem);
  }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .epd-feature--stacked,
    #shopify-section-{{ sid }} .epd-feature:not(.epd-feature--stacked) {
      grid-template-columns: 1fr 1fr;
    }
    #shopify-section-{{ sid }} .epd-feature--reverse {
      direction: rtl;
    }
    #shopify-section-{{ sid }} .epd-feature--reverse > * {
      direction: ltr;
    }
  }

  #shopify-section-{{ sid }} .epd-feature__media img {
    width: 100%;
    height: auto;
    border-radius: calc(var(--epd-radius) - 2px);
    display: block;
  }

  #shopify-section-{{ sid }} .epd-flavours .epd-flavours-hero {
    margin: 0.65rem auto 0.35rem;
    max-width: min(680px, 100%);
  }

  #shopify-section-{{ sid }} .epd-flavours .epd-flavours-hero img {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: contain;
    border-radius: calc(var(--epd-radius) - 2px);
  }

  #shopify-section-{{ sid }} .epd-flavour-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    margin-top: 1.25rem;
  }

  #shopify-section-{{ sid }} .epd-flavour-card {
    text-align: left;
    background: var(--epd-flavour-card-bg);
    border: 1px solid var(--epd-border);
    border-top: 3px solid var(--epd-flavour-card-top);
    border-radius: max(12px, calc(var(--epd-radius) - 2px));
    padding: 1.35rem 1.5rem 1.55rem;
    box-shadow: none;
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease,
      background-color 0.22s ease;
  }

  #shopify-section-{{ sid }} .epd-flavour-card h3 {
    font-size: var(--epd-subheading-size);
    font-weight: 700;
    margin: 0 0 0.7rem;
    line-height: 1.3;
  }

  #shopify-section-{{ sid }} .epd-flavour-card :is(h1, h2, h3, h4, h5, h6) {
    color: var(--epd-flavour-card-heading);
  }

  #shopify-section-{{ sid }} .epd-flavour-card p {
    margin: 0;
    color: var(--epd-flavour-card-text);
    line-height: 1.6;
    font-size: calc(var(--epd-body-size) * 0.98);
  }

  #shopify-section-{{ sid }} .epd-flavour-card p + p {
    margin-top: 0.5rem;
  }

  #shopify-section-{{ sid }} .epd-flavour-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px color-mix(in srgb, var(--epd-text) 10%, transparent);
    border-color: color-mix(in srgb, var(--epd-flavour-card-top) 35%, var(--epd-border));
    background: var(--epd-surface);
  }

  #shopify-section-{{ sid }} .epd-box__inner {
    display: grid;
    gap: 1.25rem;
    align-items: center;
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ sid }} .epd-box__copy {
    min-width: 0;
  }

  #shopify-section-{{ sid }} .epd-box.epd-block--center .epd-box__copy {
    text-align: center;
  }

  #shopify-section-{{ sid }} .epd-box.epd-block--center .epd-box__list ul,
  #shopify-section-{{ sid }} .epd-box.epd-block--center .epd-box__list ol {
    display: inline-block;
    text-align: left;
  }

  #shopify-section-{{ sid }} .epd-box__list {
    margin: 0;
  }

  #shopify-section-{{ sid }} .epd-box__media {
    justify-self: center;
    width: 100%;
    max-width: 280px;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ sid }} .epd-box__inner {
      grid-template-columns: 1fr 1fr;
    }

    #shopify-section-{{ sid }} .epd-box__media {
      justify-self: center;
      align-self: center;
      max-width: 100%;
      width: 100%;
    }
  }

  #shopify-section-{{ sid }} .epd-box__media img {
