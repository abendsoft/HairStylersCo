{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}
<div {{ block.shopify_attributes }}>
  {%- capture curlear_button_gradient_angle -%}
    {%- render 'curlear-button-gradient-angle',
      direction: block.settings.curlear_button_gradient_direction,
      angle: block.settings.curlear_button_gradient_angle
    -%}
  {%- endcapture -%}
  {%- capture curlear_buy_now_gradient_angle -%}
    {%- render 'curlear-button-gradient-angle',
      direction: block.settings.curlear_buy_now_gradient_direction,
      angle: block.settings.curlear_buy_now_gradient_angle
    -%}
  {%- endcapture -%}
  {%- style -%}
    #shopify-section-{{ section_id }} .product-form__buttons--curlear {
      max-width: 100%;
      width: 100%;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.4rem;
      align-items: stretch;
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear > * {
      flex: 1 1 0;
      min-width: 0;
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit {
      color: {{ block.settings.curlear_button_text_color | default: '#FFFFFF' }};
      background: {{ block.settings.curlear_button_bg | default: '#E7BDA9' }};
      border: 1px solid rgba(20, 20, 20, 0.2);
      box-shadow: none;
      display: flex;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
      min-width: 0;
      min-height: 5.6rem;
      margin: 0;
      border-radius: 1.2rem;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      line-height: 1;
      justify-content: center;
      align-items: center;
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit::before,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit::after,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded::before,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded::after,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button [role='button']::before,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button [role='button']::after {
      content: none !important;
      display: none !important;
      box-shadow: none !important;
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit:hover,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit:focus,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit:focus-visible,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit:active,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit:not([disabled]):hover::after,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit:not([disabled]):hover::before {
      color: {{ block.settings.curlear_button_text_color | default: '#FFFFFF' }} !important;
      background: {{ block.settings.curlear_button_bg | default: '#E7BDA9' }} !important;
      border: 1px solid rgba(20, 20, 20, 0.2) !important;
      outline: none !important;
      box-shadow: none !important;
      transform: none !important;
      opacity: 1 !important;
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit.curlear-buy-button--gradient {
      background: linear-gradient(
        {{ curlear_button_gradient_angle }},
        {{ block.settings.curlear_button_gradient_start | default: '#F2C6B4' }} 0%,
        {{ block.settings.curlear_button_gradient_middle | default: '#ECB7A3' }} 52%,
        {{ block.settings.curlear_button_gradient_end | default: '#C27A63' }} 100%
      );
      border: 0;
      box-shadow: none;
      border-radius: 1.2rem;
      padding: 0;
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit.curlear-buy-button--gradient:hover,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit.curlear-buy-button--gradient:focus,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit.curlear-buy-button--gradient:focus-visible,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .product-form__submit.curlear-buy-button--gradient:active {
      background: linear-gradient(
        {{ curlear_button_gradient_angle }},
        {{ block.settings.curlear_button_gradient_start | default: '#F2C6B4' }} 0%,
        {{ block.settings.curlear_button_gradient_middle | default: '#ECB7A3' }} 52%,
        {{ block.settings.curlear_button_gradient_end | default: '#C27A63' }} 100%
      ) !important;
      border: 0 !important;
      outline: none !important;
      box-shadow: none !important;
      transform: none !important;
      opacity: 1 !important;
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button {
      width: 100%;
      min-width: 0;
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button {
      min-height: 5.6rem;
      border-radius: 1rem;
      box-shadow: none;
      border: 1px solid rgba(20, 20, 20, 0.2);
      font-size: 17px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded {
      color: {{ block.settings.curlear_buy_now_text_color | default: '#FFFFFF' }};
      background: {{ block.settings.curlear_buy_now_bg | default: '#E7BDA9' }};
    }

    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button:hover,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button:focus,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button:focus-visible,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:hover,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:focus,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:focus-visible,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:active,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:hover:not([disabled]),
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:not([disabled]):hover::after,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:not([disabled]):hover::before,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button [role='button']:hover,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button [role='button']:focus,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button [role='button']:focus-visible,
    #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button [role='button'].focused {
      color: {{ block.settings.curlear_buy_now_text_color | default: '#FFFFFF' }} !important;
      background: {{ block.settings.curlear_buy_now_bg | default: '#E7BDA9' }} !important;
      border: 1px solid rgba(20, 20, 20, 0.2) !important;
      outline: none !important;
      box-shadow: none !important;
      transform: none !important;
      opacity: 1 !important;
    }

    {% if block.settings.curlear_buy_now_use_gradient %}
      #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded {
        background: linear-gradient(
          {{ curlear_buy_now_gradient_angle }},
          {{ block.settings.curlear_buy_now_gradient_start | default: '#F2C6B4' }} 0%,
          {{ block.settings.curlear_buy_now_gradient_middle | default: '#ECB7A3' }} 52%,
          {{ block.settings.curlear_buy_now_gradient_end | default: '#C27A63' }} 100%
        );
        border: 0;
      }

      #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:hover,
      #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:focus,
      #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:focus-visible,
      #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:active,
      #shopify-section-{{ section_id }} .product-form__buttons--curlear .shopify-payment-button__button--unbranded:hover:not([disabled]) {
        background: linear-gradient(
          {{ curlear_buy_now_gradient_angle }},
          {{ block.settings.curlear_buy_now_gradient_start | default: '#F2C6B4' }} 0%,
          {{ block.settings.curlear_buy_now_gradient_middle | default: '#ECB7A3' }} 52%,
          {{ block.settings.curlear_buy_now_gradient_end | default: '#C27A63' }} 100%
        ) !important;
        border: 0 !important;
        outline: none !important;
        box-shadow: none !important;
        transform: none !important;
        opacity: 1 !important;
      }
    {% endif %}

    @media screen and (max-width: 749px) {
      #shopify-section-{{ section_id }} .product-form__buttons--curlear {
        gap: 1rem;
      }
    }
  {%- endstyle -%}

  {%- if product != blank -%}
    {%- liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif
    -%}

    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false
            or quantity_rule_soldout
            or product.selected_or_first_available_variant == null
          %}
            disabled
          {% endif %}
          class="product-variant-id"
        >

        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        <div class="product-form__buttons product-form__buttons--curlear">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
          -%}
          <button
            id="ProductSubmitButton-{{ section_id }}"
            type="submit"
            name="add"
            class="product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}{% if block.settings.curlear_button_use_gradient %} curlear-buy-button--gradient{% endif %}"
            {% if product.selected_or_first_available_variant.available == false
              or quantity_rule_soldout
              or product.selected_or_first_available_variant == null
            %}
              disabled
            {% endif %}
          >
            <span>
              {%- if product.selected_or_first_available_variant == null -%}
                {{ 'products.product.unavailable' | t }}
              {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
                {{ 'products.product.sold_out' | t }}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
            {%- render 'loading-spinner' -%}
          </button>
          {%- if show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
      data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          <span class="svg-wrapper">
            {{- 'icon-unavailable.svg' | inline_asset_content -}}
          </span>
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
</div>
