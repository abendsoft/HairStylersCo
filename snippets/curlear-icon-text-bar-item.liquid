{% comment %}
  Renders one icon text bar item.
  @param block {object}
  @param layout {string} stack | row
{% endcomment %}
{%- liquid
  assign citb_icon_svg = block.settings.icon_svg | strip
  assign citb_has_content = false
  if block.settings.icon != blank or citb_icon_svg != blank or block.settings.heading != blank
    assign citb_has_content = true
  endif
-%}
{%- if citb_has_content -%}
  <div
    class="curlear-icon-text-bar__item{% if layout == 'row' %} curlear-icon-text-bar__item--row{% endif %}"
    {% if layout != 'row' %}role="listitem" {{ block.shopify_attributes }}{% endif %}
  >
    {%- if citb_icon_svg != blank -%}
      <div class="curlear-icon-text-bar__icon curlear-icon-text-bar__icon--svg" aria-hidden="true">
        {{ block.settings.icon_svg }}
      </div>
    {%- elsif block.settings.icon != blank -%}
      <div class="curlear-icon-text-bar__icon">
        {{
          block.settings.icon
          | image_url: width: 120
          | image_tag:
            loading: 'lazy',
            widths: '40, 60, 80, 100, 120',
            sizes: '48px',
            alt: block.settings.heading
        }}
      </div>
    {%- endif -%}
    {%- if block.settings.heading != blank -%}
      <p class="curlear-icon-text-bar__heading">{{ block.settings.heading | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
