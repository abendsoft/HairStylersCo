{% comment %}
  Swiper 11 for section "Feature Slideshow V/I".
  In layout/theme.liquid, inside <head> (often just before </head>), add once:
    {% render 'feature-slideshow-v-i-swiper' %}
  Optional: in the section editor, enable "Theme already includes Swiper 11" so the section
  does not try to inject the same assets again (either way is safe if IDs match).
{% endcomment %}
<link
  id="FeatureSlideshowVI-swiper-css"
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
  media="all"
>
<script
  id="FeatureSlideshowVI-swiper-js"
  src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
  defer
></script>
