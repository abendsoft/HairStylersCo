    "expert_product_description_DF6Gdn": {
      "type": "expert-product-description",
      "blocks": {
        "about_GFyDRk": {
          "type": "about",
          "settings": {
            "tab": "primary",
            "align_center": false,
            "extra_padding_desktop": 0,
            "title": "What is Crystal Pro CP 10k pods?",
            "text": "<p>Crystal Pro CP10000 Prefilled Pods are sealed pods designed for use with the<a href=\"https://vapeverse.co.uk/products/crystal-pro-cp-10k\">Crystal Pro CP10000 Prefilled Pod Kit</a>. Crystal Pro CP10000 Prefilled Pods include 2ml mesh pods supported by a 10ml internal refill chamber. The rated output reaches up to 10,000 puffs. Nicotine strength in Crystal Pro CP10000 Prefilled Pods measures 20mg/ml, which equals 2% under UK limits. The prefilled pods support a mouth-to-lung vaping style. The integrated 0.8Ω mesh coil heats the liquid evenly across the wick surface. The LED battery indicator and power functions operate from the main device. Flavour options in Crystal Pro CP10000 Prefilled Pods include fruit, ice, candy, and soda-inspired profiles such as Blue Razz Cherry, Cherry Ice, Double Apple, Fresh Mint, Pineapple Ice, Strawberry Kiwi, Watermelon Ice, and Blue Razz Lemonade.<br/><br/></p>"
          }
        },
        "spec_table_hfetDJ": {
          "type": "spec_table",
          "settings": {
            "tab": "primary",
            "align_center": false,
            "extra_padding_desktop": 0,
            "title": "Specifications",
            "col_feature": "Feature",
            "col_detail": "Details",
            "row_1_name": "Product Name",
            "row_1_detail": "<p>Crystal Pro CP10000 Prefilled Pods</p>",
            "row_2_name": "Device Compatibility",
            "row_2_detail": "<p>Crystal Pro CP10000 device only</p>",
            "row_3_name": "Pod Type",
            "row_3_detail": "<p>Sealed prefilled mesh pod</p>",
            "row_4_name": "Pod Chamber Capacity",
            "row_4_detail": "<p>2ml</p>",
            "row_5_name": "Refill Chamber Capacity",
            "row_5_detail": "<p>10ml internal refill chamber</p>",
            "row_6_name": "Puff Capacity",
            "row_6_detail": "<p>Up to 10,000 puffs (lab conditions)</p>",
            "row_7_name": "Nicotine Strength",
            "row_7_detail": "<p>20mg/ml nicotine salt (2%)</p>",
            "row_8_name": "Nicotine Format",
            "row_8_detail": "<p>Nicotine salt</p>",
            "row_9_name": "Coil Type",
            "row_9_detail": "<p>0.8Ω mesh coil</p>",
            "row_10_name": "Vaping Style",
            "row_10_detail": "<p>Mouth-to-lung (MTL)</p>",
            "row_11_name": "",
            "row_11_detail": "",
            "row_12_name": "",
            "row_12_detail": "",
            "row_13_name": "",
            "row_13_detail": "",
