    "curlear_image_accordion_showcase_NNPnT4": {
      "type": "curlear-image-accordion-showcase",
      "blocks": {
        "row_gKLY7B": {
          "type": "row",
          "settings": {
            "heading": "Is the curlear 5-in-1 Hair Styler suitable for all hair types?",
            "content": "<p>Yes. With adjustable heat settings (55°C, 80°C and 105°C) and multiple styling attachments, you can customise your routine for fine, normal, thick, curly, coloured or treated hair.</p>"
          }
        },
        "row_WNVNE6": {
          "type": "row",
          "settings": {
            "heading": "How does the auto-curling technology work?",
            "content": "<p>The curling barrels use high-velocity airflow to create a low-pressure effect that gently draws hair onto the barrel and wraps it automatically, creating curls without manually winding each section.</p>"
          }
        },
        "row_AbeeeE": {
          "type": "row",
          "settings": {
            "heading": "What attachments are included with the Curlear Hair Styler?",
            "content": "<p>The styler includes 5 interchangeable attachments: two auto-curling barrels, a blow dryer head, a flat massage brush and a cylinder massage brush for drying, smoothing, curling and adding volume.</p>"
          }
        },
        "row_HYVKkm": {
          "type": "row",
          "disabled": true,
          "settings": {
            "heading": "Is the curling iron dual voltage for international use?",
            "content": "<p>Is the curling iron dual voltage for international use?<br/><br/></p>"
          }
        },
        "row_cerqmX": {
          "type": "row",
          "settings": {
            "heading": "What heat setting should I use for my hair type?",
            "content": "<p>Use 55°C for fine, fragile, coloured or damaged hair, 80°C for normal hair, and 105°C for thick, coarse or resistant hair. Always start with the lowest setting that achieves your desired style.</p>"
          }
        },
        "row_NfWeMN": {
          "type": "row",
          "settings": {
            "heading": "How does AEROFLUX™ protect hair from excessive heat?",
            "content": "<p>Unlike traditional hot plates, Curlear styles using controlled airflow and lower heat levels, shaping hair while it dries for a gentler styling experience.</p>"
          }
        }
      },
