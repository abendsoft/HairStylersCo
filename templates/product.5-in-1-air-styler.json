        "curlear_collapsible_rq4Ab3": {
          "type": "curlear_collapsible",
          "settings": {
            "open_first_row": true,
            "caret_icon": "shopify://shop_images/down-arrow.png",
            "row_1_title": "What's Included",
            "row_1_content": "<p>2x Auto Curling Barrels (Left & Right)</p><p>1x Blow Dryer Head</p><p>1x Flat Massage Brush</p><p>1x Cylinder Massage Brush</p><p>1x User Manual</p>",
            "row_2_title": "Details",
            "row_2_content": "<p><strong>Premium Quality. Zero Risk.</strong><br/>Crafted from high-grade ABS and aluminium alloy, this device is built to last. And with our <strong>30-day money-back guarantee</strong>, your purchase is completely protected.</p><p><strong>Your Personal At-Home Stylist</strong><br/>Smooth, glossy, bouncy or voluminous — achieve polished, professional finishes in minutes, without ever stepping into a salon.</p><p><strong>Fast Styling for Busy Days</strong><br/>Perfect for morning routines or last-minute plans, thanks to its powerful 1000W motor and rapid heat technology.</p><p><strong>Gentle on Hair, Powerful in Performance</strong><br/>The intelligent heat control keeps your hair protected, reducing frizz and preventing damage, no matter your hair type.</p><p><strong>Compact & Travel-Ready</strong><br/>Sleek, lightweight, and easy to carry — your perfect styling partner anywhere in the world.</p><p><strong>Made for Every Hair Type</strong><br/>Straight, curly, wavy, fine, thick — this tool adapts to you, not the other way around.</p><p><strong>Five Tools in One</strong><br/>Replace clutter with one intelligent device that dries, curls, straightens, volumises, and smooths effortlessly.</p><p><strong>Endless Creativity</strong><br/>Switch attachments instantly and create a new look every day — soft curls, beach waves, sleek straight hair, or full volume.</p>",
            "row_3_title": "Features",
            "row_3_content": "<ul><li>3 heat/speed settings</li><li>Push-button quick-change heads</li><li>Ergonomic design</li><li>Anti-frizz airflow</li><li>Ideal for ages 7+</li></ul>",
            "row_4_title": "",
            "row_4_content": ""
          }
        }
