        "curlear_collapsible_rq4Ab3": {
          "type": "curlear_collapsible",
          "settings": {
            "open_first_row": true,
            "caret_icon": "shopify://shop_images/down-arrow.png",
            "row_1_title": "What's Included",
            "row_1_content": "<p>2x Auto Curling Barrels (Left & Right)</p><p>1x Blow Dryer Head</p><p>1x Flat Massage Brush</p><p>1x Cylinder Massage Brush</p><p>1x User Manual</p>",
            "row_2_title": "Details",
            "row_2_content": "<p><strong>Salon-Quality Curls. Zero Effort.</strong><br/>Crafted from high-grade ABS and aluminium alloy, this device is built to last. With just the touch of a button, you get smooth, salon-quality curls without the hassle of manual styling.</p><p><strong>Your Personal At-Home Stylist</strong><br/>The automatic rotating barrel wraps your hair smoothly and evenly, giving you soft curls, beach waves, or bouncy volume in minutes — no salon visit required.</p><p><strong>Fast Styling for Busy Days</strong><br/>Perfect for morning routines or last-minute plans. Just clamp, wait, and release for effortless curls that fit into even the busiest schedule.</p><p><strong>Gentle on Hair, Powerful in Performance</strong><br/>Adjustable heat and timer settings let you customize your style while helping reduce heat damage, so your hair stays protected no matter your routine.</p><p><strong>Made for Every Hair Type</strong><br/>Straight, wavy, thick, or fine — the adjustable heat settings adapt to your hair, giving you control over the perfect curl every time.</p><p><strong>Lightweight & Easy to Use</strong><br/>The ergonomic, lightweight design makes styling quick, safe, and comfortable to hold, so you can curl your hair with confidence and ease.</p><p><strong>Long-Lasting Results</strong><br/>Enjoy curls that hold their shape, shine, and bounce all day long — styled once, ready for anything.</p><p><strong>Reliable Performance, Guaranteed</strong><br/>Comes with a 1-year warranty, so you can style with confidence knowing your investment is protected.</p>",
            "row_3_title": "Features",
            "row_3_content": "<ul><li>Built-in timer for consistent, precise curls</li><li>Long-lasting curls, shine, and bounce</li><li>Lightweight, ergonomic design for easy handling</li><li>Reduces heat damage while styling</li><li>1-year warranty included</li></ul>",
            "row_4_title": "",
            "row_4_content": ""
          }
        }
      },
